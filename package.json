{
  "name": "markify",
  "productName": "Markify",
  "version": "1.3.0",
  "main": "src/main/index.js",
  "description": "Markify - Lightweight Electron app for live Markdown preview from CLI with auto-reload, emoji support, and syntax highlighting",
  "repository": {
    "type": "git",
    "url": "git@github.com:AllefDouglasDev/markdown-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/AllefDouglasDev/markdown-viewer/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "homepage": "https://github.com/AllefDouglasDev/markdown-viewer#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/generate-icon.js",
    "webpack": "webpack",
    "webpack:watch": "webpack --watch",
    "test": "electron . example.md",
    "prepare": "webpack",
    "update": "npm run webpack && echo 'Global link updated! Run: md <file.md>'",
    "prebuild": "npm run webpack",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder -mwl --publish never",
    "release": "npm run prebuild && electron-builder --publish always"
  },
  "bin": {
    "md": "./bin/md"
  },
  "keywords": [
    "markdown",
    "electron",
    "viewer",
    "preview",
    "renderer",
    "cli",
    "live-reload",
    "gfm",
    "github-flavored-markdown",
    "syntax-highlighting",
    "emoji",
    "neovim",
    "vim"
  ],
  "author": "Allef Douglas Cruz <allefwalker73@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.7",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.19",
    "postcss-loader": "^8.2.1",
    "process": "^0.11.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.3",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.552.0",
    "mark.js": "^8.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "build": {
    "appId": "com.allef.markify",
    "productName": "Markify",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "bin/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "package.json",
      "docs/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
